# pptx-to-video 配置（主配置方式）
# 复制为 .env 并填入你的 API Key

# ── 生成引擎 ──
# 可选: siliconflow | kling | volcengine | comfyui | custom_api
PROVIDER=siliconflow

# ── 视觉风格 ──
# 可选: auto | modern luxury | tech innovation | nature organic
#        | fashion editorial | corporate clean | warm lifestyle
VISUAL_STYLE=auto
# 可选：整体主题描述（如 "运动科技"、"母婴用品"等）
OVERALL_THEME=

# ── SiliconFlow 专用 ──
SILICONFLOW_API_KEY=***
BASE_URL=https://api.siliconflow.cn
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B

# ── Seedream 专用（字节跳动文生图，使用火山引擎 API Key）──
SEEDREAM_MODEL=seedream-250

# ── Seedance 专用（字节跳动视频生成，使用火山引擎 API Key）──
SEEDANCE_MODEL=seedance-2.0

# ── 可灵AI (Kling) 专用 ──
KLING_API_KEY=
KLING_IMAGE_MODEL=kling-v1
KLING_VIDEO_MODEL=kling-v1

# ── 火山引擎 (Volcengine/豆包) 专用 ──
VOLC_API_KEY=
VOLC_IMAGE_MODEL=doubao-vision-pro-32k
VOLC_VIDEO_MODEL=seed-video-v1

# ── ComfyUI 专用（本地免费）──
COMFYUI_BASE_URL=http://127.0.0.1:8188

# ── 自定义API 专用 ──
CUSTOM_API_BASE_URL=
CUSTOM_API_IMAGE_MODEL=
CUSTOM_API_VIDEO_MODEL=

# ── 视频参数 ──
FPS=24
VIDEO_SIZE=1280x720
VIDEO_DURATION=5
MAX_CONCURRENT=3
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
POLL_INTERVAL=3.0
POLL_TIMEOUT=3600
TEMP_DIR=./temp

# ── 字幕 ──
SUBTITLE_FONT_SIZE=36
SUBTITLE_COLOR=white
SUBTITLE_BG_COLOR=black@0.5

# ── 时长 & 关键帧 ──
# 时长模式: auto（每页推荐时长）或固定秒数
DURATION_MODE=auto
# 每页生成的关键帧图片数量（1-6，越多图片越丰富，但生成时间更长）
IMAGES_PER_SLIDE=2
# 启用角色/场景一致性（所有页面共享统一风格）
ENABLE_CONSISTENCY=true
# 启用预览 & 反馈界面（生成后弹窗审查）
ENABLE_PREVIEW=true
